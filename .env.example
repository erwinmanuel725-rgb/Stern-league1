# --- Obligatoire ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stern
# Généré avec : npm run hash-password
ADMIN_PASSWORD_HASH=
# --- Optionnel ---
NODE_ENV=development
PORT=3000
ADMIN_SESSION_HOURS=12
# Minutes avant le coup d'envoi où les paris se ferment (0 = au coup d'envoi)
BET_CLOSE_MINUTES=0
# true seulement si tu utilises l'URL PUBLIQUE de Railway (proxy TCP)
DATABASE_SSL=false
# Alertes d'erreur (facultatif) : npm i @sentry/node puis renseigner
SENTRY_DSN=
